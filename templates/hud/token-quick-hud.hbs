{{#*inline "shHudActionChip"}}
  <div
    class="sh-action-chip {{#if isFavorite}}is-favorite{{/if}} {{#if iconOnly}}is-icon{{/if}}"
    draggable="true"
    data-drag-action-id="{{id}}"
    data-drag-label="{{fullLabel}}"
    data-drag-img="{{dragImg}}"
  >
    <button
      type="button"
      class="sh-action-btn sh-action-chip__main"
      data-action="run-action"
      data-action-id="{{id}}"
      data-focus-scope="{{scope}}"
      {{#if noFavorite}}data-no-favorite="true"{{/if}}
      aria-label="{{fullLabel}}"
      data-tooltip="{{tooltip}}"
      {{#unless enabled}}disabled{{/unless}}
    >
      {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i>{{/if}}
      <span class="sh-action-btn__label">{{text}}</span>
      {{#if apCost}}<span class="sh-action-btn__cost">{{apCost}}</span>{{/if}}
    </button>
  </div>
{{/inline}}

{{#*inline "shHudAmmo"}}
  {{#if ammo.length}}
    <span class="sh-token-quick-hud__ammo" aria-hidden="true">
      {{#each ammo as |d|}}
        {{#if d.isBar}}
          <span class="sh-token-quick-hud__ammo-bar" style="--sh-ammo-ticks: {{d.ticks}}"><span style="width: {{d.fillPct}}%"></span></span>
        {{else if d.isPips}}
          <span class="sh-token-quick-hud__ammo-pips">{{#each d.pips as |p|}}<span class="{{#if p.filled}}is-filled{{/if}}"></span>{{/each}}</span>
        {{else}}
          <span class="sh-token-quick-hud__ammo-count">{{d.text}}</span>
        {{/if}}
      {{/each}}
    </span>
  {{/if}}
{{/inline}}

{{#*inline "shHudFireButton"}}
  <button
    type="button"
    class="sh-token-quick-hud__mode-btn {{#if b.isActive}}is-active{{/if}}"
    data-action="switch-mode"
    data-item-id="{{g.itemId}}"
    data-line-id="{{b.lineId}}"
    data-mode-id="{{b.modeId}}"
    data-focus-scope="{{scope}}"
    data-tooltip="{{b.tooltip}}"
    aria-pressed="{{#if b.isActive}}true{{else}}false{{/if}}"
    {{#if b.draggable}}draggable="true" data-drag-attack-uuid="{{g.itemUuid}}" data-drag-line-id="{{b.lineId}}" data-drag-mode-id="{{b.modeId}}"{{/if}}
  >{{b.name}}</button>
{{/inline}}

{{#*inline "shHudItemCard"}}
  <div
    class="sh-token-quick-hud__held-item {{#if isStowed}}is-stowed{{/if}} {{#if isWeapon}}is-weapon{{#unless ready}} is-not-ready{{/unless}}{{/if}}"
    data-zone="tray"
    data-held-item
    data-item-id="{{itemId}}"
    data-item-uuid="{{itemUuid}}"
    {{#if canAttack}}draggable="true" data-drag-attack-uuid="{{itemUuid}}"{{/if}}
  >
    <button
      type="button"
      class="sh-token-quick-hud__held-select"
      data-action="select-held-item"
      data-item-id="{{itemId}}"
      data-tooltip="{{tooltip}}"
      data-focus-scope="held"
      aria-label="{{tooltip}}{{#if isWeapon}}{{#unless ready}} — {{notReadyLabel}}{{/unless}}{{/if}}"
    >
      {{#if img}}
        <img class="sh-token-quick-hud__held-img" src="{{img}}" alt="" />
      {{else}}
        <span class="sh-token-quick-hud__held-img sh-token-quick-hud__held-img--placeholder">
          <i class="{{icon}}" aria-hidden="true"></i>
        </span>
      {{/if}}
      <span class="sh-token-quick-hud__held-meta">
        <span class="sh-token-quick-hud__held-name">{{name}}</span>
        {{#if modeLabel}}
          <span class="sh-token-quick-hud__held-detail">{{modeLabel}}</span>
        {{/if}}
      </span>
      {{#if isWeapon}}
        {{#unless ready}}
          <i class="fa-solid fa-triangle-exclamation sh-token-quick-hud__readiness" aria-hidden="true"></i>
        {{/unless}}
      {{/if}}
      {{> shHudAmmo}}
    </button>
  </div>
{{/inline}}

<section
  id="spaceholder-token-quick-hud"
  class="spaceholder sh-token-quick-hud {{#if isEmpty}}is-empty{{/if}}"
  data-actor-id="{{actorId}}"
  data-expanded="{{#if isExpanded}}true{{else}}false{{/if}}"
  aria-label="{{ariaLabel}}"
>
  {{#if isEmpty}}
    <div class="sh-token-quick-hud__empty-pill" role="status">
      <i class="fa-solid fa-user-slash" aria-hidden="true"></i>
      <span>{{actorName}}</span>
    </div>
  {{else}}
    <div class="sh-token-quick-hud__stack">
      {{#if hasSelection}}
        <div class="sh-token-quick-hud__selected" role="group" aria-label="{{selectedLabel}}">
          <div class="sh-token-quick-hud__selected-list">
            {{#each selectedGroups as |g|}}
              <div
                class="sh-token-quick-hud__selected-card {{#if g.notReady}}is-not-ready{{/if}} {{#if g.isStowed}}is-stowed{{/if}}"
                data-zone="selected"
                data-held-item
                data-item-id="{{g.itemId}}"
                data-item-uuid="{{g.itemUuid}}"
                {{#if g.canAttack}}draggable="true" data-drag-attack-uuid="{{g.itemUuid}}"{{/if}}
              >
                <div class="sh-token-quick-hud__selected-icon">
                  {{#if g.img}}
                    <img class="sh-token-quick-hud__selected-img" src="{{g.img}}" alt="" />
                  {{else}}
                    <span class="sh-token-quick-hud__selected-img sh-token-quick-hud__selected-img--placeholder">
                      <i class="{{g.icon}}" aria-hidden="true"></i>
                    </span>
                  {{/if}}
                  <button
                    type="button"
                    class="icon-btn sh-token-quick-hud__deselect"
                    data-action="deselect-item"
                    data-item-id="{{g.itemId}}"
                    data-focus-scope="selected"
                    data-tooltip="{{g.deselectLabel}}"
                    aria-label="{{g.deselectLabel}}: {{g.name}}"
                  >
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                  </button>
                </div>

                <div class="sh-token-quick-hud__selected-main">
                  <span class="sh-token-quick-hud__selected-name" data-tooltip="{{g.name}}">{{g.name}}</span>
                  <div class="sh-token-quick-hud__selected-foot" role="group" aria-label="{{g.toolsLabel}}">
                    {{#if g.itemTools.length}}
                      <div class="sh-actions-grid sh-token-quick-hud__selected-tools">
                        {{#each g.itemTools as |a|}}
                          {{> shHudActionChip a scope="selected-tools" text=a.compactLabel fullLabel=a.label}}
                        {{/each}}
                      </div>
                    {{/if}}
                    <button
                      type="button"
                      class="icon-btn sh-token-quick-hud__tool sh-token-quick-hud__item-menu"
                      data-action="item-menu"
                      data-item-id="{{g.itemId}}"
                      data-focus-scope="item-menu"
                      data-tooltip="{{g.menuLabel}}"
                      aria-label="{{g.menuLabel}}"
                      aria-haspopup="menu"
                    >
                      <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>

                {{#if g.hasLoadout}}
                  <div class="sh-token-quick-hud__fire {{#unless g.hasModes}}is-tabs-only{{/unless}}">
                    {{#if g.lineSwitch.length}}
                      <div class="sh-token-quick-hud__line-tabs" role="group" aria-label="{{@root.fireLineLabel}}">
                        {{#each g.lineSwitch as |b|}}
                          {{> shHudFireButton b=b g=g scope="fire-line"}}
                        {{/each}}
                      </div>
                    {{/if}}
                    <div class="sh-token-quick-hud__fire-row">
                      {{#if g.weaponTools.length}}
                        <div class="sh-actions-grid sh-token-quick-hud__selected-tools">
                          {{#each g.weaponTools as |a|}}
                            {{> shHudActionChip a scope="weapon-tools" text=a.compactLabel fullLabel=a.label}}
                          {{/each}}
                        </div>
                      {{/if}}
                      {{#if g.notReady}}
                        <span class="sh-token-quick-hud__ammo-pill">
                          <i
                            class="fa-solid fa-triangle-exclamation sh-token-quick-hud__readiness"
                            data-tooltip="{{g.notReadyLabel}}"
                            aria-label="{{g.notReadyLabel}}"
                          ></i>
                          {{> shHudAmmo g}}
                        </span>
                      {{else if g.ammo.length}}
                        <span class="sh-token-quick-hud__ammo-pill">{{> shHudAmmo g}}</span>
                      {{/if}}
                      {{#if g.modeSwitch.length}}
                        <div class="sh-token-quick-hud__mode-plate" role="group" aria-label="{{@root.fireModeLabel}}">
                          {{#each g.modeSwitch as |b|}}
                            {{> shHudFireButton b=b g=g scope="fire-mode"}}
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  </div>
                {{/if}}
              </div>
            {{/each}}
          </div>

          {{#if attack.show}}
            <button
              type="button"
              class="sh-token-quick-hud__attack {{#unless attack.enabled}}is-disabled{{/unless}} {{#if attack.isBlocked}}is-blocked{{/if}} {{#if attack.unaffordable}}is-unaffordable{{/if}} {{#if attack.isAiming}}is-aiming{{/if}}"
              data-action="{{#if attack.isAiming}}cancel-aim{{else}}attack{{/if}}"
              data-item-id="{{attack.itemId}}"
              data-focus-scope="attack"
              data-tooltip="{{attack.tooltip}}"
              aria-label="{{#if attack.isAiming}}{{attack.tooltip}}{{else}}{{attack.label}}: {{attack.tooltip}}{{/if}}"
              aria-disabled="{{#if attack.enabled}}false{{else}}true{{/if}}"
              {{#if attack.canDrag}}draggable="true" data-drag-attack-uuid="{{attack.itemUuid}}"{{/if}}
            >
              <span class="sh-token-quick-hud__attack-label">
                {{#if attack.isAiming}}<i class="fa-solid fa-xmark" aria-hidden="true"></i>{{/if}}{{attack.label}}
              </span>
              {{#if attack.shotText}}
                <span class="sh-token-quick-hud__attack-cost">
                  {{#if attack.prepText}}
                    <span class="sh-token-quick-hud__attack-prep">{{attack.prepText}}</span>
                    <span class="sh-token-quick-hud__attack-sep" aria-hidden="true">+</span>
                  {{/if}}
                  <span class="sh-token-quick-hud__attack-shot"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i>{{attack.shotText}}</span>
                </span>
              {{/if}}
              {{#if attack.isBlocked}}
                <i class="fa-solid fa-triangle-exclamation sh-token-quick-hud__attack-warn" aria-hidden="true"></i>
              {{/if}}
              {{#if attack.hint}}
                <span class="sh-token-quick-hud__attack-hint">{{attack.hint}}</span>
              {{/if}}
            </button>
          {{/if}}
        </div>
      {{/if}}

      {{#if hasCards}}
        <div class="sh-token-quick-hud__held-islands" role="group" aria-label="{{heldLabel}}">
          {{#each heldCards as |card|}}
            {{> shHudItemCard card}}
          {{/each}}
          {{#if hasStowedCards}}
            {{#if heldCards.length}}<span class="sh-token-quick-hud__held-divider" aria-hidden="true"></span>{{/if}}
            {{#each stowedCards as |card|}}
              {{> shHudItemCard card}}
            {{/each}}
          {{/if}}
        </div>
      {{/if}}

      {{#if hasActions}}
        <div
          id="spaceholder-token-quick-hud-drawer"
          class="sh-token-quick-hud__drawer"
          aria-hidden="{{#if isExpanded}}false{{else}}true{{/if}}"
          {{#unless isExpanded}}inert hidden{{/unless}}
        >
          <div class="sh-token-quick-hud__drawer-header">
            <div class="sh-token-quick-hud__drawer-title">
              <i class="fa-solid fa-bolt" aria-hidden="true"></i>
              <span>{{quickActionsLabel}}</span>
              <span class="sh-token-quick-hud__count" aria-hidden="true">{{actionCount}}</span>
            </div>
          </div>
          <div
            class="sh-actions-grid sh-token-quick-hud__drawer-actions"
            role="group"
            aria-label="{{quickActionsLabel}}"
          >
            {{#each generalActions as |a|}}
              {{> shHudActionChip a scope="drawer" text=a.label fullLabel=a.label}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      <div class="sh-token-quick-hud__dock" role="toolbar" aria-label="{{ariaLabel}}">
        <div class="sh-token-quick-hud__identity">
          <button
            type="button"
            class="sh-token-quick-hud__portrait-wrap"
            data-action="view-portrait"
            data-focus-scope="identity"
            data-tooltip="{{viewPortraitLabel}}"
            aria-label="{{viewPortraitLabel}}"
          >
            {{#if tokenImg}}
              <img class="sh-token-quick-hud__portrait" src="{{tokenImg}}" alt="" />
            {{else}}
              <span class="sh-token-quick-hud__portrait sh-token-quick-hud__portrait--placeholder" aria-hidden="true">
                <i class="fa-solid fa-user"></i>
              </span>
            {{/if}}
          </button>

          <div class="sh-token-quick-hud__identity-meta">
            <span class="sh-token-quick-hud__title" data-tooltip="{{actorName}}">{{actorName}}</span>
            <div class="sh-token-quick-hud__status">
              {{#if showAp}}
                <span
                  class="sh-token-quick-hud__ap {{#if apEmpty}}is-empty{{/if}} {{#if apSpent}}is-spent{{/if}}"
                  data-tooltip="{{apTooltip}}"
                  aria-label="{{apTooltip}}: {{apText}}"
                >
                  <i class="fa-solid {{#if apSpent}}fa-hourglass-half{{else}}fa-bolt{{/if}}" aria-hidden="true"></i>
                  <span class="sh-token-quick-hud__ap-value">{{apText}}</span>
                </span>
              {{/if}}
              {{#each effects as |e|}}
                <img class="sh-token-quick-hud__effect" src="{{e.img}}" alt="{{e.name}}" data-tooltip="{{e.name}}" />
              {{/each}}
              {{#if effectsOverflow}}
                <span class="sh-token-quick-hud__effect-more" data-tooltip="{{effectsOverflowTooltip}}">+{{effectsOverflow}}</span>
              {{/if}}
            </div>
            <div class="sh-token-quick-hud__identity-tools">
              <button
                type="button"
                class="icon-btn sh-token-quick-hud__tool"
                data-action="pan-to-token"
                data-focus-scope="identity"
                data-tooltip="{{panToTokenLabel}}"
                aria-label="{{panToTokenLabel}}"
              >
                <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
              </button>
              <button
                type="button"
                class="icon-btn sh-token-quick-hud__tool"
                data-action="open-sheet"
                data-focus-scope="identity"
                data-tooltip="{{openSheetLabel}}"
                aria-label="{{openSheetLabel}}"
              >
                <i class="fa-solid fa-id-card" aria-hidden="true"></i>
              </button>
              {{#if canConfigureToken}}
                <button
                  type="button"
                  class="icon-btn sh-token-quick-hud__tool"
                  data-action="open-token-config"
                  data-focus-scope="identity"
                  data-tooltip="{{openTokenConfigLabel}}"
                  aria-label="{{openTokenConfigLabel}}"
                >
                  <i class="fa-solid fa-gear" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
          </div>
        </div>

        <div
          class="sh-token-quick-hud__health"
          role="group"
          aria-label="{{healthLabel}}"
        >
          <span class="sh-token-quick-hud__health-head">
            <i class="fa-solid fa-heart-pulse" aria-hidden="true"></i>
            <span>{{healthLabel}}</span>
          </span>
          <span class="sh-token-quick-hud__health-track" aria-hidden="true"></span>
          <span class="sh-token-quick-hud__health-value">—</span>
        </div>

        <div class="sh-actions-grid sh-token-quick-hud__preview" role="group" aria-label="{{quickActionsLabel}}">
          {{#if hasActions}}
            {{#each generalActions as |a|}}
              {{> shHudActionChip a scope="dock" text=a.label fullLabel=a.label}}
            {{/each}}
          {{else}}
            <span class="sh-token-quick-hud__empty-text">{{noActionsLabel}}</span>
          {{/if}}
        </div>

        {{#if hasActions}}
          <button
            type="button"
            class="icon-btn sh-token-quick-hud__drawer-toggle"
            data-action="toggle-drawer"
            data-focus-scope="dock"
            data-tooltip="{{#if isExpanded}}{{collapseLabel}}{{else}}{{expandLabel}}{{/if}}"
            aria-label="{{#if isExpanded}}{{collapseLabel}}{{else}}{{expandLabel}}{{/if}}"
            aria-controls="spaceholder-token-quick-hud-drawer"
            aria-expanded="{{#if isExpanded}}true{{else}}false{{/if}}"
            hidden
          >
            <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
            <span class="sh-token-quick-hud__overflow-count" aria-hidden="true"></span>
          </button>
        {{/if}}
      </div>
    </div>
  {{/if}}
</section>

{{!-- Заголовок вкладки внутри .tab. Опционально: action, actionIcon, actionLabelKey. --}}
<header class="sh-tab-banner" data-tab="{{tab}}" {{#if group}}data-group="{{group}}"{{/if}}>
  <i class="{{icon}}" aria-hidden="true"></i>
  <span>{{localize labelKey}}</span>
  {{#if @root.editable}}
  {{#if action}}
  <button type="button" class="icon-btn sh-tab-banner__action" data-action="{{action}}" data-tooltip="{{localize actionLabelKey}}" aria-label="{{localize actionLabelKey}}">
    <i class="{{actionIcon}}" aria-hidden="true"></i>
  </button>
  {{/if}}
  {{/if}}
</header>

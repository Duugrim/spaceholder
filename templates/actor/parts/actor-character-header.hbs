{{!-- Character sheet: портрет + иконка фракции (клик — открыть лист фракции); подпись справа от иконки --}}
<header
  class="sheet-header sh-character-header"
  style="--sh-character-header-accent: {{#if characterHeaderAccent}}{{characterHeaderAccent}}{{else}}#3d4a5c{{/if}};{{#if factionColor}} --faction-color: {{factionColor}};{{/if}}"
>
  <div class="sh-character-header__card">
    <div class="sh-character-header__top">
      <div class="sh-portrait sh-character-header__portrait">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="166" width="166" alt=""/>
      </div>
      {{#if system.gFaction}}
        <div class="sh-character-header__factionCluster">
        <a
          class="sh-character-header__factionIconWrap"
          href="#"
          data-action="uuid-open"
          data-uuid="{{system.gFaction}}"
          data-tooltip="{{localize 'SPACEHOLDER.Character.OpenFactionSheet'}}"
          aria-label="{{localize 'SPACEHOLDER.Character.OpenFactionSheet'}}"
        >
          {{#if gFactionImg}}
            <img class="sh-character-header__factionIconImg" src="{{gFactionImg}}" width="75" height="75" alt="" />
          {{else}}
            <span class="sh-character-header__factionIconPh" aria-hidden="true"><i class="fa-solid fa-flag"></i></span>
          {{/if}}
        </a>
        <div class="sh-character-header__caption">
          <div class="sh-character-header__captionRow">
            <span class="sh-character-header__captionFactionName">{{gFactionName}}</span>
          </div>
        </div>
        </div>
      {{else}}
        <div class="sh-character-header__factionCluster">
        <div class="sh-character-header__factionIconWrap">
          <span class="sh-character-header__factionIconPh sh-character-header__factionIconPh--disposition" aria-hidden="true"><i class="{{characterDispositionIconClass}}"></i></span>
        </div>
        <div class="sh-character-header__caption">
          <span class="sh-character-header__captionFactionName">{{characterDispositionLabel}}</span>
        </div>
        </div>
      {{/if}}
    </div>
  </div>
  <div class="sh-character-header__nameRow">
    <h1 class="charname sh-character-header__name">{{actor.name}}</h1>
    {{#if deathNote}}
      <i class="fa-solid fa-skull sh-character-header__dead" data-tooltip="{{deathNote}}"></i>
    {{else if dyingNote}}
      <i class="fa-solid fa-heart-pulse sh-character-header__dying" data-tooltip="{{dyingNote}}"></i>
    {{/if}}
    {{#if editable}}
      <button
        type="button"
        class="icon-btn sh-character-header__edit"
        data-action="sh-character-header-edit"
        data-tooltip="{{localize 'SPACEHOLDER.Character.HeaderEditButton'}}"
        aria-label="{{localize 'SPACEHOLDER.Character.HeaderEditButton'}}"
      ><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
    {{/if}}
  </div>
  {{#if actionPointsCurrent}}
    <div class="sh-character-header__ap {{#if actionPointsCurrent.isSpent}}is-spent{{/if}}">
      <span
        class="sh-character-header__ap-inner"
        data-tooltip="{{actionPointsCurrent.tooltip}}"
        aria-label="{{actionPointsCurrent.tooltip}}"
      >
        <span class="sh-character-header__ap-label">{{#if actionPointsCurrent.isSpent}}{{localize 'SPACEHOLDER.ActionsSystem.UI.APSpentHeaderLabel'}}{{else}}{{localize 'SPACEHOLDER.ActionsSystem.UI.APHeaderLabel'}}{{/if}}</span>
        <span class="sh-character-header__ap-value">{{#if actionPointsCurrent.isSpent}}{{actionPointsCurrent.value}}{{else}}{{actionPointsCurrent.value}} / {{actionPointsCurrent.max}}{{/if}}</span>
      </span>
    </div>
  {{/if}}
</header>

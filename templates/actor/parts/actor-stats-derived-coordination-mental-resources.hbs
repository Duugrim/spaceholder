<div class="stats-panel">
  <div class="capacities-list">
    <div class="sh-derived-groups">
      {{#if system.derivedStats}}
      <div class="spaceholder-derived-group">
        <div class="spaceholder-derived-group__heading">{{localize 'SPACEHOLDER.Derived.Groups.Coordination'}}</div>
        <div class="spaceholder-derived-group__body">
          <div class="spaceholder-derived-group__body-inner">
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.Dexterity'}}">{{localize 'SPACEHOLDER.Derived.Dexterity'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{numberFormat system.derivedStats.dexterityScore decimals=0}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.ActionSpeed'}}">{{localize 'SPACEHOLDER.Derived.ActionSpeed'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{numberFormat system.derivedStats.actionSpeedBonusPct decimals=0 sign=true}}%</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.Reaction'}}">{{localize 'SPACEHOLDER.Derived.Reaction'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{numberFormat system.derivedStats.reactionScore decimals=0}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.Accuracy'}}">{{localize 'SPACEHOLDER.Derived.Accuracy'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{numberFormat system.derivedStats.accuracyScore decimals=0}}</span></div>
          </div>
          </div>
        </div>
      </div>

      <div class="spaceholder-derived-group">
        <div class="spaceholder-derived-group__heading">{{localize 'SPACEHOLDER.Derived.Groups.Mental'}}</div>
        <div class="spaceholder-derived-group__body">
          <div class="spaceholder-derived-group__body-inner">
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.Awareness'}}">{{localize 'SPACEHOLDER.Derived.Awareness'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{numberFormat system.derivedStats.awarenessScore decimals=0}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.LearnRate'}}">{{localize 'SPACEHOLDER.Derived.LearnRate'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{numberFormat system.derivedStats.learnRateScore decimals=0}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.SkillBudget'}}">{{localize 'SPACEHOLDER.Derived.SkillBudget'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{system.derivedStats.skillBudget}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.Will'}}">{{localize 'SPACEHOLDER.Derived.Will'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{numberFormat system.derivedStats.willScore decimals=0}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.Intuition'}}">{{localize 'SPACEHOLDER.Derived.Intuition'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{system.derivedStats.intuitionMax}}</span></div>
          </div>
          </div>
        </div>
      </div>
      {{/if}}

      <div class="spaceholder-derived-group">
        <div class="spaceholder-derived-group__heading">{{localize 'SPACEHOLDER.Derived.Groups.Resources'}}</div>
        <div class="spaceholder-derived-group__body">
          <div class="spaceholder-derived-group__body-inner">
          <div class="sh-derived-ap sh-derived-ap--in-group">
            <div class="capacity-line">
              <div class="capacity-name">{{localize 'SPACEHOLDER.ActionsSystem.UI.ActionPoints'}}</div>
              <div class="capacity-value sh-derived-value">
                {{#if actionPointsCurrent}}
                  <span class="ability-mod sh-derived-readonly">{{actionPointsCurrent.base}}</span>
                {{else}}
                  <span class="ability-mod sh-derived-readonly">0</span>
                {{/if}}
              </div>
            </div>
          </div>
          {{#if system.derivedStats}}
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.Heroism'}}">{{localize 'SPACEHOLDER.Derived.Heroism'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{system.derivedStats.heroismPoints}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.Derived.Tooltip.SecondWind'}}">{{localize 'SPACEHOLDER.Derived.SecondWind'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{system.derivedStats.secondWindPoints}}</span></div>
          </div>
          <div class="capacity-line">
            <div class="capacity-name" data-tooltip="{{localize 'SPACEHOLDER.ActionsSystem.UI.TurnStartsTooltip'}}">{{localize 'SPACEHOLDER.ActionsSystem.UI.TurnStarts'}}</div>
            <div class="capacity-value sh-derived-value"><span class="ability-mod sh-derived-readonly">{{system.derivedStats.turnsPerRound}}</span></div>
          </div>
          {{/if}}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

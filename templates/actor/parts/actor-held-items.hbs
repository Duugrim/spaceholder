<section class="sh-held-items-panel">
  <p class="sh-held-items-summary">{{heldItemsSummary}}</p>

  {{#if heldItems.length}}
    {{!-- One toolbar for the selected item; the cards below only select. --}}
    <div class="sh-held-toolbar" role="toolbar" aria-label="{{heldSelected.name}}">
      <div class="sh-held-toolbar__tools">
        {{#if heldSelected.canAttack}}
          <button type="button" class="icon-btn" data-item-id="{{heldSelected.id}}" data-action="sh-held-item-attack" data-tooltip="{{localize 'SPACEHOLDER.Inventory.HeldActions.AttackTooltip'}}" aria-label="{{localize 'SPACEHOLDER.Inventory.HeldActions.AttackTooltip'}}"><i class="fa-solid fa-crosshairs"></i></button>
        {{/if}}
        <button type="button" class="icon-btn" data-item-id="{{heldSelected.id}}" data-action="sh-held-item-open" data-tooltip="{{localize 'SPACEHOLDER.Inventory.HeldActions.OpenTooltip'}}" aria-label="{{localize 'SPACEHOLDER.Inventory.HeldActions.OpenTooltip'}}"><i class="fa-solid fa-pen-to-square"></i></button>
      </div>
      {{> "systems/spaceholder/templates/actor/parts/actor-item-action-chips.hbs" actions=heldSelected.actions}}
    </div>

    <div class="sh-held-items-list">
      {{#each heldItems as |entry|}}
        <article
          class="sh-held-item-card{{#if entry.isSelected}} is-selected{{/if}}"
          data-item-id="{{entry.id}}"
          data-action="sh-held-item-select"
          role="button"
          tabindex="0"
          aria-pressed="{{#if entry.isSelected}}true{{else}}false{{/if}}"
          title="{{entry.name}}"
        >
          <div class="sh-held-item-card__image">
            <img src="{{entry.img}}" alt="" width="42" height="42" />
          </div>
          <div class="sh-held-item-card__info">
            <span class="sh-held-item-card__name">{{entry.name}}</span>
            {{#if entry.typeLabel}}<div class="sh-held-item-card__meta">{{entry.typeLabel}}</div>{{/if}}
          </div>
        </article>
      {{/each}}
    </div>
  {{/if}}
</section>
